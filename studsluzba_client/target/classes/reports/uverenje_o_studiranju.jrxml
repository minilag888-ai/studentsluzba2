<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports
              http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="uverenje_o_studiranju" pageWidth="595" pageHeight="842"
              columnWidth="535" leftMargin="30" rightMargin="30"
              topMargin="20" bottomMargin="20">

    <parameter name="ime" class="java.lang.String"/>
    <parameter name="prezime" class="java.lang.String"/>
    <parameter name="brojIndeksa" class="java.lang.Integer"/>
    <parameter name="godinaIndeksa" class="java.lang.Integer"/>
    <parameter name="studijskiProgram" class="java.lang.String"/>
    <parameter name="datumIzdavanja" class="java.time.LocalDate"/>

    <title>
        <band height="150">
            <!-- Header -->
            <staticText>
                <reportElement x="0" y="10" width="535" height="30"/>
                <textElement textAlignment="Center">
                    <font size="18" isBold="true"/>
                </textElement>
                <text><![CDATA[Računarski fakultet - Univerzitet Union]]></text>
            </staticText>

            <line>
                <reportElement x="0" y="50" width="535" height="1"/>
            </line>

            <staticText>
                <reportElement x="0" y="70" width="535" height="30"/>
                <textElement textAlignment="Center">
                    <font size="16" isBold="true"/>
                </textElement>
                <text><![CDATA[UVERENJE O STUDIRANJU]]></text>
            </staticText>

            <staticText>
                <reportElement x="0" y="110" width="535" height="20"/>
                <textElement textAlignment="Left">
                    <font size="12"/>
                </textElement>
                <text><![CDATA[Fakultet potvrđuje da je:]]></text>
            </staticText>
        </band>
    </title>

    <detail>
        <band height="300">
            <!-- Ime i prezime -->
            <textField>
                <reportElement x="50" y="20" width="435" height="25"/>
                <textElement>
                    <font size="14" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{ime} + " " + $P{prezime}]]></textFieldExpression>
            </textField>

            <!-- Broj indeksa -->
            <staticText>
                <reportElement x="50" y="55" width="150" height="20"/>
                <textElement>
                    <font size="12"/>
                </textElement>
                <text><![CDATA[Broj indeksa:]]></text>
            </staticText>

            <textField>
                <reportElement x="200" y="55" width="285" height="20"/>
                <textElement>
                    <font size="12" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{godinaIndeksa} + "/" + $P{brojIndeksa} + " - " + $P{studijskiProgram}]]></textFieldExpression>
            </textField>

            <!-- Tekst -->
            <staticText>
                <reportElement x="0" y="100" width="535" height="60"/>
                <textElement textAlignment="Justified">
                    <font size="12"/>
                </textElement>
                <text><![CDATA[redovan student/kinja Računarskog fakulteta - Univerzitet Union, i da je upisao/la tekuću školsku godinu.

Uverenje se izdaje radi ostvarivanja prava na:]]></text>
            </staticText>

            <staticText>
                <reportElement x="50" y="170" width="435" height="40"/>
                <textElement>
                    <font size="11"/>
                </textElement>
                <text><![CDATA[□ prevoz
□ socijalnu zaštitu
□ ostalo: _______________________________]]></text>
            </staticText>

            <!-- Datum -->
            <staticText>
                <reportElement x="50" y="240" width="100" height="20"/>
                <textElement>
                    <font size="11"/>
                </textElement>
                <text><![CDATA[Datum izdavanja:]]></text>
            </staticText>

            <textField>
                <reportElement x="150" y="240" width="150" height="20"/>
                <textElement>
                    <font size="11"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{datumIzdavanja}.toString()]]></textFieldExpression>
            </textField>
        </band>
    </detail>

    <pageFooter>
        <band height="80">
            <line>
                <reportElement x="350" y="10" width="150" height="1"/>
            </line>

            <staticText>
                <reportElement x="350" y="15" width="150" height="20"/>
                <textElement textAlignment="Center">
                    <font size="10"/>
                </textElement>
                <text><![CDATA[Pečat i potpis]]></text>
            </staticText>

            <staticText>
                <reportElement x="0" y="50" width="535" height="20"/>
                <textElement textAlignment="Center">
                    <font size="9" isItalic="true"/>
                </textElement>
                <text><![CDATA[Računarski fakultet | Kneza Višeslava 1a, Beograd | www.raf.edu.rs]]></text>
            </staticText>
        </band>
    </pageFooter>

</jasperReport>
<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports
              http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="uverenje_o_polozenim_ispitima"
              pageWidth="595"
              pageHeight="842"
              columnWidth="535"
              leftMargin="30"
              rightMargin="30"
              topMargin="20"
              bottomMargin="20"
              whenNoDataType="AllSectionsNoDetail">

    <parameter name="ime" class="java.lang.String"/>
    <parameter name="prezime" class="java.lang.String"/>
    <parameter name="brojIndeksa" class="java.lang.Integer"/>
    <parameter name="godinaIndeksa" class="java.lang.Integer"/>
    <parameter name="studijskiProgram" class="java.lang.String"/>
    <parameter name="datumIzdavanja" class="java.time.LocalDate"/>

    <field name="sifraPredmeta" class="java.lang.String"/>
    <field name="nazivPredmeta" class="java.lang.String"/>
    <field name="espb" class="java.lang.Integer"/>
    <field name="ocena" class="java.lang.Integer"/>

    <variable name="ukupnoESPB" class="java.lang.Integer" calculation="Sum">
        <variableExpression><![CDATA[$F{espb}]]></variableExpression>
    </variable>

    <variable name="prosecnaOcena" class="java.lang.Double" calculation="Average">
        <variableExpression><![CDATA[$F{ocena}.doubleValue()]]></variableExpression>
    </variable>

    <background>
        <band height="802">
            <!-- HEADER -->
            <staticText>
                <reportElement x="0" y="10" width="535" height="25"/>
                <textElement textAlignment="Center">
                    <font size="16" isBold="true"/>
                </textElement>
                <text><![CDATA[Računarski fakultet - Univerzitet Union]]></text>
            </staticText>

            <line>
                <reportElement x="0" y="40" width="535" height="1"/>
            </line>

            <staticText>
                <reportElement x="0" y="50" width="535" height="25"/>
                <textElement textAlignment="Center">
                    <font size="14" isBold="true"/>
                </textElement>
                <text><![CDATA[UVERENJE O POLOŽENIM ISPITIMA]]></text>
            </staticText>

            <!-- INFO O STUDENTU -->
            <staticText>
                <reportElement x="0" y="90" width="80" height="20"/>
                <textElement><font size="10" isBold="true"/></textElement>
                <text><![CDATA[Student:]]></text>
            </staticText>

            <textField isBlankWhenNull="true">
                <reportElement x="80" y="90" width="250" height="20"/>
                <textElement><font size="10"/></textElement>
                <textFieldExpression><![CDATA[$P{ime} + " " + $P{prezime}]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement x="0" y="115" width="80" height="20"/>
                <textElement><font size="10" isBold="true"/></textElement>
                <text><![CDATA[Indeks:]]></text>
            </staticText>

            <textField isBlankWhenNull="true">
                <reportElement x="80" y="115" width="250" height="20"/>
                <textElement><font size="10"/></textElement>
                <textFieldExpression><![CDATA[$P{godinaIndeksa} + "/" + $P{brojIndeksa} + " - " + $P{studijskiProgram}]]></textFieldExpression>
            </textField>

            <!-- FOOTER -->
            <line>
                <reportElement x="350" y="720" width="150" height="1"/>
            </line>

            <staticText>
                <reportElement x="350" y="725" width="150" height="20"/>
                <textElement textAlignment="Center">
                    <font size="9"/>
                </textElement>
                <text><![CDATA[Pečat i potpis]]></text>
            </staticText>

            <staticText>
                <reportElement x="0" y="770" width="535" height="15"/>
                <textElement textAlignment="Center">
                    <font size="8" isItalic="true"/>
                </textElement>
                <text><![CDATA[Računarski fakultet | Kneza Višeslava 1a, Beograd | www.raf.edu.rs]]></text>
            </staticText>
        </band>
    </background>

    <columnHeader>
        <band height="25">
            <staticText>
                <reportElement x="0" y="5" width="60" height="15"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center"><font size="9" isBold="true"/></textElement>
                <text><![CDATA[Šifra]]></text>
            </staticText>

            <staticText>
                <reportElement x="60" y="5" width="280" height="15"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center"><font size="9" isBold="true"/></textElement>
                <text><![CDATA[Naziv predmeta]]></text>
            </staticText>

            <staticText>
                <reportElement x="340" y="5" width="95" height="15"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center"><font size="9" isBold="true"/></textElement>
                <text><![CDATA[ESPB]]></text>
            </staticText>

            <staticText>
                <reportElement x="435" y="5" width="100" height="15"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center"><font size="9" isBold="true"/></textElement>
                <text><![CDATA[Ocena]]></text>
            </staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="18">
            <textField isBlankWhenNull="true">
                <reportElement x="0" y="0" width="60" height="18"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center"><font size="8"/></textElement>
                <textFieldExpression><![CDATA[$F{sifraPredmeta}]]></textFieldExpression>
            </textField>

            <textField isBlankWhenNull="true">
                <reportElement x="60" y="0" width="280" height="18"/>
                <box leftPadding="5"><pen lineWidth="0.5"/></box>
                <textElement><font size="8"/></textElement>
                <textFieldExpression><![CDATA[$F{nazivPredmeta}]]></textFieldExpression>
            </textField>

            <textField isBlankWhenNull="true">
                <reportElement x="340" y="0" width="95" height="18"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center"><font size="8"/></textElement>
                <textFieldExpression><![CDATA[$F{espb}]]></textFieldExpression>
            </textField>

            <textField isBlankWhenNull="true">
                <reportElement x="435" y="0" width="100" height="18"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center"><font size="8" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$F{ocena}]]></textFieldExpression>
            </textField>
        </band>
    </detail>

    <summary>
        <band height="80">
            <staticText>
                <reportElement x="240" y="15" width="100" height="18"/>
                <textElement textAlignment="Right">
                    <font size="11" isBold="true"/>
                </textElement>
                <text><![CDATA[Ukupno ESPB:]]></text>
            </staticText>

            <textField isBlankWhenNull="true">
                <reportElement x="340" y="15" width="95" height="18"/>
                <textElement textAlignment="Center">
                    <font size="11" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$V{ukupnoESPB}]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement x="240" y="38" width="100" height="18"/>
                <textElement textAlignment="Right">
                    <font size="11" isBold="true"/>
                </textElement>
                <text><![CDATA[Prosečna ocena:]]></text>
            </staticText>

            <textField pattern="#0.00" isBlankWhenNull="true">
                <reportElement x="340" y="38" width="95" height="18"/>
                <textElement textAlignment="Center">
                    <font size="11" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$V{prosecnaOcena}]]></textFieldExpression>
            </textField>
        </band>
    </summary>

</jasperReport>

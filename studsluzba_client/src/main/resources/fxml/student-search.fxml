<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.raflab.studsluzba.client.controllers.StudentSearchController"
      spacing="15"
      stylesheets="@../css/style.css">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Label text="Pretraga studenata" styleClass="title"/>

    <!-- 1. Pretraga po broju indeksa -->
    <VBox spacing="10" styleClass="search-section">
        <Label text="Pretraga po broju indeksa" styleClass="section-title"/>
        <HBox spacing="10" alignment="CENTER_LEFT">
            <Label text="Godina:" minWidth="80"/>
            <TextField fx:id="txtGodina" promptText="2023" prefWidth="100"/>

            <Label text="Broj:" minWidth="60"/>
            <TextField fx:id="txtBroj" promptText="59" prefWidth="100"/>

            <Label text="Oznaka:" minWidth="70"/>
            <TextField fx:id="txtOznaka" promptText="SPI" prefWidth="100"/>

            <Button text="Pretraži" onAction="#onSearchByIndeks" styleClass="primary-button"/>
        </HBox>
    </VBox>

    <Separator/>

    <!-- 2. Pretraga po imenu/prezimenu -->
    <VBox spacing="10" styleClass="search-section">
        <Label text="Pretraga po imenu/prezimenu" styleClass="section-title"/>
        <HBox spacing="10" alignment="CENTER_LEFT">
            <Label text="Ime:" minWidth="80"/>
            <TextField fx:id="txtIme" promptText="Unesite ime" prefWidth="200"/>

            <Label text="Prezime:" minWidth="80"/>
            <TextField fx:id="txtPrezime" promptText="Unesite prezime" prefWidth="200"/>

            <Button text="Pretraži" onAction="#onSearchByName" styleClass="primary-button"/>
        </HBox>
    </VBox>

    <Separator/>

    <!-- 3. Pretraga po srednjoj školi -->
    <VBox spacing="10" styleClass="search-section">
        <Label text="Pretraga po srednjoj školi" styleClass="section-title"/>
        <HBox spacing="10" alignment="CENTER_LEFT">
            <Label text="Srednja škola:" minWidth="120"/>
            <ComboBox fx:id="cmbSrednjaSkola" prefWidth="300" promptText="Izaberite srednju školu"/>
            <Button text="Pretraži" onAction="#onSearchBySrednjaSkola" styleClass="primary-button"/>
            <Button text="🔄 Osveži" onAction="#onRefreshSkole"/>
        </HBox>
    </VBox>

    <Separator/>

    <!-- Rezultati pretrage -->
    <VBox spacing="10" VBox.vgrow="ALWAYS">
        <HBox spacing="10" alignment="CENTER_LEFT">
            <Label text="Rezultati pretrage" styleClass="section-title"/>
            <Button text="Obriši rezultate" onAction="#onClearSearch" styleClass="secondary-button"/>
        </HBox>

        <TableView fx:id="tableStudents" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colIme" text="Ime" prefWidth="150"/>
                <TableColumn fx:id="colPrezime" text="Prezime" prefWidth="150"/>
                <TableColumn fx:id="colEmail" text="Indeks" prefWidth="150"/>
                <TableColumn fx:id="colJmbg" text="Status" prefWidth="100"/>
                <TableColumn fx:id="colSrednjaSkola" text="ID Indeksa" prefWidth="100"/>
            </columns>
            <placeholder>
                <Label text="Nema rezultata pretrage"/>
            </placeholder>
        </TableView>

        <Pagination fx:id="pagination"/>
    </VBox>

</VBox>

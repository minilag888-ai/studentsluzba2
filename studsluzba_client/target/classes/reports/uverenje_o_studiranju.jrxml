<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports
              http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="uverenje_o_studiranju"
              pageWidth="595"
              pageHeight="842"
              columnWidth="535"
              leftMargin="30"
              rightMargin="30"
              topMargin="20"
              bottomMargin="20"
              whenNoDataType="AllSectionsNoDetail">

    <parameter name="ime" class="java.lang.String"/>
    <parameter name="prezime" class="java.lang.String"/>
    <parameter name="brojIndeksa" class="java.lang.Integer"/>
    <parameter name="godinaIndeksa" class="java.lang.Integer"/>
    <parameter name="studijskiProgram" class="java.lang.String"/>
    <parameter name="datumIzdavanja" class="java.time.LocalDate"/>

    <background>
        <band height="802">
            <!-- HEADER -->
            <staticText>
                <reportElement x="0" y="10" width="535" height="30"/>
                <textElement textAlignment="Center">
                    <font size="18" isBold="true"/>
                </textElement>
                <text><![CDATA[Računarski fakultet - Univerzitet Union]]></text>
            </staticText>

            <line>
                <reportElement x="0" y="50" width="535" height="1"/>
            </line>

            <staticText>
                <reportElement x="0" y="70" width="535" height="30"/>
                <textElement textAlignment="Center">
                    <font size="16" isBold="true"/>
                </textElement>
                <text><![CDATA[UVERENJE O STUDIRANJU]]></text>
            </staticText>

            <staticText>
                <reportElement x="0" y="130" width="535" height="20"/>
                <textElement textAlignment="Left">
                    <font size="12"/>
                </textElement>
                <text><![CDATA[Fakultet potvrđuje da je:]]></text>
            </staticText>

            <!-- IME I PREZIME -->
            <textField isBlankWhenNull="true">
                <reportElement x="50" y="170" width="435" height="25"/>
                <textElement>
                    <font size="14" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{ime} + " " + $P{prezime}]]></textFieldExpression>
            </textField>

            <!-- BROJ INDEKSA LABEL -->
            <staticText>
                <reportElement x="50" y="210" width="150" height="20"/>
                <textElement>
                    <font size="12"/>
                </textElement>
                <text><![CDATA[Broj indeksa:]]></text>
            </staticText>

            <!-- BROJ INDEKSA VALUE -->
            <textField isBlankWhenNull="true">
                <reportElement x="200" y="210" width="200" height="20"/>
                <textElement>
                    <font size="12" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{godinaIndeksa} + "/" + $P{brojIndeksa}]]></textFieldExpression>
            </textField>

            <!-- STUDIJSKI PROGRAM LABEL -->
            <staticText>
                <reportElement x="50" y="240" width="150" height="20"/>
                <textElement>
                    <font size="12"/>
                </textElement>
                <text><![CDATA[Studijski program:]]></text>
            </staticText>

            <!-- STUDIJSKI PROGRAM VALUE -->
            <textField isBlankWhenNull="true">
                <reportElement x="200" y="240" width="300" height="20"/>
                <textElement>
                    <font size="12" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{studijskiProgram}]]></textFieldExpression>
            </textField>

            <!-- TEKST TELA -->
            <staticText>
                <reportElement x="50" y="290" width="435" height="60"/>
                <textElement textAlignment="Justified">
                    <font size="11"/>
                </textElement>
                <text><![CDATA[Student navedenog studijskog programa Računarskog fakulteta, Univerziteta Union u Beogradu, i potvrđujemo da je aktivan u akademskoj 2024/2025 godini.]]></text>
            </staticText>

            <!-- DATUM IZDAVANJA LABEL -->
            <staticText>
                <reportElement x="50" y="370" width="200" height="20"/>
                <textElement>
                    <font size="11"/>
                </textElement>
                <text><![CDATA[Datum izdavanja:]]></text>
            </staticText>

            <!-- DATUM IZDAVANJA VALUE -->
            <textField isBlankWhenNull="true">
                <reportElement x="250" y="370" width="150" height="20"/>
                <textElement>
                    <font size="11"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{datumIzdavanja}.toString()]]></textFieldExpression>
            </textField>

            <!-- LINIJA ZA POTPIS -->
            <line>
                <reportElement x="350" y="470" width="150" height="1"/>
            </line>

            <!-- PEČAT I POTPIS -->
            <staticText>
                <reportElement x="350" y="475" width="150" height="20"/>
                <textElement textAlignment="Center">
                    <font size="10"/>
                </textElement>
                <text><![CDATA[Pecat i potpis]]></text>
            </staticText>

            <!-- FOOTER -->
            <staticText>
                <reportElement x="0" y="760" width="535" height="15"/>
                <textElement textAlignment="Center">
                    <font size="9" isItalic="true"/>
                </textElement>
                <text><![CDATA[Računarski fakultet |  Beograd | www.raf.edu.rs]]></text>
            </staticText>
        </band>
    </background>

</jasperReport>

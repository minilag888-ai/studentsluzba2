<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.raflab.studsluzba.client.controllers.StudentSearchController"
      stylesheets="@../css/style.css"
      spacing="20" prefWidth="1100" prefHeight="700">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <!-- Header -->
    <Label text="Pretraga studenata" styleClass="page-title">
        <font>
            <Font name="System Bold" size="24"/>
        </font>
    </Label>

    <Separator/>

    <!-- Pretraga po broju indeksa -->
    <VBox spacing="10" styleClass="search-section">
        <Label text="Pretraga po broju indeksa:" styleClass="section-label">
            <font>
                <Font name="System Bold" size="14"/>
            </font>
        </Label>

        <HBox spacing="15" alignment="CENTER_LEFT">
            <Label text="Godina:"/>
            <TextField fx:id="txtGodina" promptText="2023" prefWidth="80"/>

            <Label text="Broj:"/>
            <TextField fx:id="txtBroj" promptText="123" prefWidth="80"/>

            <Label text="Oznaka:"/>
            <TextField fx:id="txtOznaka" promptText="RA" prefWidth="80"/>

            <Button fx:id="btnSearchByIndeks" text="🔍 Pretraži po indeksu"
                    onAction="#onSearchByIndeks" styleClass="search-button"/>
        </HBox>
    </VBox>

    <!-- Pretraga po imenu/prezimenu -->
    <VBox spacing="10" styleClass="search-section">
        <Label text="Pretraga po imenu i/ili prezimenu:" styleClass="section-label">
            <font>
                <Font name="System Bold" size="14"/>
            </font>
        </Label>

        <HBox spacing="15" alignment="CENTER_LEFT">
            <Label text="Ime:"/>
            <TextField fx:id="txtIme" promptText="Unesite ime" prefWidth="200"/>

            <Label text="Prezime:"/>
            <TextField fx:id="txtPrezime" promptText="Unesite prezime" prefWidth="200"/>

            <Button fx:id="btnSearchByName" text="🔍 Pretraži po imenu"
                    onAction="#onSearchByName" styleClass="search-button"/>

            <Button text="🗑️ Obriši" onAction="#onClearSearch" styleClass="clear-button"/>
        </HBox>
    </VBox>

    <Separator/>

    <!-- Rezultati pretrage -->
    <VBox spacing="10" VBox.vgrow="ALWAYS">
        <Label text="Rezultati pretrage:" styleClass="section-label">
            <font>
                <Font name="System Bold" size="14"/>
            </font>
        </Label>

        <TableView fx:id="tableStudents" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colIme" text="Ime" prefWidth="150"/>
                <TableColumn fx:id="colPrezime" text="Prezime" prefWidth="150"/>
                <TableColumn fx:id="colEmail" text="Email" prefWidth="250"/>
                <TableColumn fx:id="colJmbg" text="JMBG" prefWidth="150"/>
            </columns>
            <placeholder>
                <Label text="Nema rezultata. Unesite kriterijume pretrage."
                       style="-fx-text-fill: gray;"/>
            </placeholder>
        </TableView>

        <!-- Pagination -->
        <HBox alignment="CENTER">
            <Pagination fx:id="pagination" pageCount="1"/>
        </HBox>
    </VBox>

    <!-- Info -->
    <HBox alignment="CENTER_LEFT" spacing="10" styleClass="info-section">
        <Label text="💡 Dupli klik na studenta za otvaranje profila"/>
    </HBox>

</VBox>
<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>


<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.raflab.studsluzba.client.controllers.MainController"
            stylesheets="@../css/style.css">
            prefWidth="1200" prefHeight="800">

    <!-- TOP: Menu i Navigacija -->
    <top>
        <VBox>
            <!-- Menu Bar -->
            <MenuBar>
                <Menu text="Studenti">
                    <MenuItem text="Pretraga studenata" onAction="#onStudentiClick"/>
                </Menu>
                <Menu text="Ispiti">
                    <MenuItem text="Pregled ispita" onAction="#onIspitiClick"/>
                </Menu>
                <Menu text="Predmeti">
                    <MenuItem text="Pregled predmeta" onAction="#onPredmetiClick"/>
                </Menu>
                <Menu text="Izveštaji">
                    <MenuItem text="Izveštaji" onAction="#onIzvestajiClick"/>
                </Menu>
            </MenuBar>
        </VBox>
    </top>

    <!-- CENTER: Content Area (dinamički se menja) -->
    <center>
        <BorderPane fx:id="mainContainer">
            <!-- Početni ekran -->
            <StackPane>
                <VBox alignment="CENTER" spacing="30">
                    <Label text="Studentska Služba" styleClass="title">
                        <font>
                            <Font name="System Bold" size="36"/>
                        </font>
                    </Label>
                    <Label text="Računarski fakultet - Univerzitet Union" styleClass="subtitle">
                        <font>
                            <Font size="18"/>
                        </font>
                    </Label>

                    <VBox spacing="15" alignment="CENTER">
                        <HBox spacing="20" alignment="CENTER">
                            <Button text="🔍 Studenti" onAction="#onStudentiClick"
                                    prefWidth="180" prefHeight="80" styleClass="main-button"/>
                            <Button text="📝 Ispiti" onAction="#onIspitiClick"
                                    prefWidth="180" prefHeight="80" styleClass="main-button"/>
                            <Button text="📚 Predmeti" onAction="#onPredmetiClick"
                                    prefWidth="180" prefHeight="80" styleClass="main-button"/>
                        </HBox>
                    </VBox>
                </VBox>
            </StackPane>
        </BorderPane>
    </center>

    <!-- BOTTOM: Status bar -->
    <bottom>
        <HBox spacing="10" alignment="CENTER_LEFT" styleClass="status-bar">
            <padding>
                <Insets top="5" right="10" bottom="5" left="10"/>
            </padding>
            <Label text="● Povezano sa serverom: http://localhost:8090"/>
        </HBox>
    </bottom>

</BorderPane>
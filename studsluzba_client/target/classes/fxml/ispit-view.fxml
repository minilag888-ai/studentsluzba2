<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.raflab.studsluzba.client.controllers.IspitController"
      stylesheets="@../css/style.css">
      spacing="15" prefWidth="1100" prefHeight="750">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <!-- Header -->
    <HBox alignment="CENTER_LEFT" spacing="20">
        <Label text="Ispiti" styleClass="page-title">
            <font>
                <Font name="System Bold" size="24"/>
            </font>
        </Label>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="➕ Dodaj ispitni rok" onAction="#onDodajIspitniRok" styleClass="add-button"/>
        <Button text="➕ Dodaj ispit" onAction="#onDodajIspit" styleClass="add-button"/>
    </HBox>

    <Separator/>

    <!-- Tabela ispita -->
    <VBox spacing="10" VBox.vgrow="SOMETIMES">
        <Label text="Svi ispiti:" styleClass="section-label">
            <font>
                <Font name="System Bold" size="14"/>
            </font>
        </Label>

        <TableView fx:id="tableIspiti" prefHeight="250">
            <columns>
                <TableColumn fx:id="colPredmet" text="Predmet" prefWidth="300"/>
                <TableColumn fx:id="colRok" text="Ispitni rok" prefWidth="150"/>
                <TableColumn fx:id="colDatum" text="Datum" prefWidth="120"/>
            </columns>
        </TableView>

        <HBox spacing="10" alignment="CENTER_LEFT">
            <Button fx:id="btnPrikaziRezultate" text="📊 Prikaži rezultate"
                    onAction="#onPrikaziRezultate" styleClass="action-button"/>
            <Button fx:id="btnGenerisiZapisnik" text="📄 Generiši zapisnik"
                    onAction="#onGenerisiZapisnik" styleClass="action-button"/>
        </HBox>
    </VBox>

    <Separator/>

    <!-- Tabela rezultata -->
    <VBox spacing="10" VBox.vgrow="ALWAYS">
        <Label text="Rezultati ispita:" styleClass="section-label">
            <font>
                <Font name="System Bold" size="14"/>
            </font>
        </Label>

        <TableView fx:id="tableRezultati" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colIndeks" text="Indeks" prefWidth="100"/>
                <TableColumn fx:id="colIme" text="Ime i prezime" prefWidth="200"/>
                <TableColumn fx:id="colPoeni" text="Ukupno poeni" prefWidth="120"/>
                <TableColumn fx:id="colOcena" text="Ocena" prefWidth="80"/>
            </columns>
        </TableView>
    </VBox>

    <!-- Info -->
    <HBox alignment="CENTER_LEFT" spacing="10" styleClass="info-section">
        <Label text="💡 Selektujte ispit pa kliknite 'Prikaži rezultate' za prikaz studenata"/>
    </HBox>

</VBox>
<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.raflab.studsluzba.client.controllers.StudentProfileController"
      stylesheets="@../css/style.css"
      spacing="15" prefWidth="1150" prefHeight="800">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <!-- Header sa osnovnim podacima -->
    <HBox alignment="CENTER_LEFT" spacing="30" styleClass="profile-header">
        <VBox spacing="8" HBox.hgrow="ALWAYS">
            <Label text="Profil studenta" styleClass="page-title">
                <font>
                    <Font name="System Bold" size="24"/>
                </font>
            </Label>
            <HBox spacing="15">
                <Label fx:id="lblIme" text="-" styleClass="student-name">
                    <font>
                        <Font name="System Bold" size="18"/>
                    </font>
                </Label>
                <Label fx:id="lblPrezime" text="-" styleClass="student-name">
                    <font>
                        <Font name="System Bold" size="18"/>
                    </font>
                </Label>
            </HBox>
            <HBox spacing="20">
                <HBox spacing="5">
                    <Label text="Indeks:" styleClass="label-bold"/>
                    <Label fx:id="lblIndeks" text="-"/>
                </HBox>
                <HBox spacing="5">
                    <Label text="Email:" styleClass="label-bold"/>
                    <Label fx:id="lblEmail" text="-"/>
                </HBox>
            </HBox>
        </VBox>

        <!-- Statistika -->
        <VBox spacing="5" alignment="CENTER" styleClass="stat-box">
            <Label text="ESPB" styleClass="stat-label"/>
            <Label fx:id="lblEspb" text="0" styleClass="stat-value">
                <font>
                    <Font name="System Bold" size="22"/>
                </font>
            </Label>
        </VBox>

        <VBox spacing="5" alignment="CENTER" styleClass="stat-box">
            <Label text="Prosek" styleClass="stat-label"/>
            <Label fx:id="lblProsek" text="0.00" styleClass="stat-value">
                <font>
                    <Font name="System Bold" size="22"/>
                </font>
            </Label>
        </VBox>

        <VBox spacing="5" alignment="CENTER" styleClass="stat-box">
            <Label text="Preostalo za uplatu" styleClass="stat-label"/>
            <Label fx:id="lblPreostaliIznos" text="0.00 EUR" styleClass="stat-value">
                <font>
                    <Font name="System Bold" size="16"/>
                </font>
            </Label>
        </VBox>
    </HBox>

    <Separator/>

    <!-- Akcije -->
    <HBox spacing="12" alignment="CENTER_LEFT">
        <Button fx:id="btnUverenjeOStudiranju" text="📄 Uverenje o studiranju"
                onAction="#onGenerateUverenjeOStudiranju" styleClass="action-button" prefWidth="200"/>
        <Button fx:id="btnUverenjeOPolozenim" text="📋 Uverenje o položenim"
                onAction="#onGenerateUverenjeOPolozenim" styleClass="action-button" prefWidth="200"/>
    </HBox>

    <Separator/>

    <!-- TabPane sa detaljima -->
    <TabPane fx:id="tabPane" VBox.vgrow="ALWAYS" tabClosingPolicy="UNAVAILABLE">

        <!-- TAB 1: Položeni predmeti -->
        <Tab text="Položeni predmeti">
            <VBox spacing="12">
                <padding>
                    <Insets top="15" right="15" bottom="15" left="15"/>
                </padding>

                <TableView fx:id="tablePolozeni" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colSifra" text="Šifra" prefWidth="80"/>
                        <TableColumn fx:id="colNaziv" text="Naziv predmeta" prefWidth="350"/>
                        <TableColumn fx:id="colEspb" text="ESPB" prefWidth="70"/>
                        <TableColumn fx:id="colOcena" text="Ocena" prefWidth="70"/>
                        <TableColumn fx:id="colDatum" text="Datum" prefWidth="120"/>
                    </columns>
                    <placeholder>
                        <Label text="Nema položenih predmeta" style="-fx-text-fill: gray;"/>
                    </placeholder>
                </TableView>
            </VBox>
        </Tab>

        <!-- TAB 2: Nepoloženi predmeti -->
        <Tab text="Nepoloženi predmeti">
            <VBox spacing="12">
                <padding>
                    <Insets top="15" right="15" bottom="15" left="15"/>
                </padding>

                <TableView fx:id="tableNepolozeni" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colSifraNepolozeni" text="Šifra" prefWidth="80"/>
                        <TableColumn fx:id="colNazivNepolozeni" text="Naziv predmeta" prefWidth="350"/>
                        <TableColumn fx:id="colEspbNepolozeni" text="ESPB" prefWidth="70"/>
                        <TableColumn fx:id="colBrojPokusaja" text="Pokušaji" prefWidth="100"/>
                    </columns>
                    <placeholder>
                        <Label text="Nema nepoloženih predmeta" style="-fx-text-fill: gray;"/>
                    </placeholder>
                </TableView>
            </VBox>
        </Tab>

        <!-- TAB 3: Upisane godine -->
        <Tab text="Upisane godine">
            <VBox spacing="12">
                <padding>
                    <Insets top="15" right="15" bottom="15" left="15"/>
                </padding>

                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Button text="➕ Upiši godinu" onAction="#onUpisGodine"
                            styleClass="add-button" prefWidth="140"/>
                </HBox>

                <TableView fx:id="tableUpisaneGodine" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colGodinaStudija" text="Godina studija" prefWidth="120"/>
                        <TableColumn fx:id="colSkolskaGodina" text="Školska godina" prefWidth="150"/>
                        <TableColumn fx:id="colDatumUpisa" text="Datum upisa" prefWidth="120"/>
                        <TableColumn fx:id="colUkupnoESPB" text="ESPB" prefWidth="70"/>
                        <TableColumn fx:id="colNapomena" text="Napomena" prefWidth="300"/>
                    </columns>
                    <placeholder>
                        <Label text="Nema upisanih godina" style="-fx-text-fill: gray;"/>
                    </placeholder>
                </TableView>
            </VBox>
        </Tab>

        <!-- TAB 4: Obnovljene godine -->
        <Tab text="Obnovljene godine">
            <VBox spacing="12">
                <padding>
                    <Insets top="15" right="15" bottom="15" left="15"/>
                </padding>

                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Button text="🔄 Obnovi godinu" onAction="#onObnovaGodine"
                            styleClass="action-button" prefWidth="140"/>
                </HBox>

                <TableView fx:id="tableObnovljeneGodine" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colGodinaObnovljene" text="Godina studija" prefWidth="120"/>
                        <TableColumn fx:id="colSkolskaGodinaObnova" text="Školska godina" prefWidth="150"/>
                        <TableColumn fx:id="colDatumObnove" text="Datum obnove" prefWidth="120"/>
                        <TableColumn fx:id="colUkupnoESPBObnova" text="ESPB" prefWidth="70"/>
                        <TableColumn fx:id="colNapomenaObnova" text="Napomena" prefWidth="300"/>
                    </columns>
                    <placeholder>
                        <Label text="Nema obnovljenih godina" style="-fx-text-fill: gray;"/>
                    </placeholder>
                </TableView>
            </VBox>
        </Tab>

        <!-- TAB 5: Uplate -->
        <Tab text="Uplate">
            <VBox spacing="12">
                <padding>
                    <Insets top="15" right="15" bottom="15" left="15"/>
                </padding>

                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Button text="💰 Dodaj uplatu" onAction="#onDodajUplatu"
                            styleClass="add-button" prefWidth="140"/>
                </HBox>

                <TableView fx:id="tableUplate" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colDatumUplate" text="Datum" prefWidth="120"/>
                        <TableColumn fx:id="colIznosEur" text="Iznos (EUR)" prefWidth="120"/>
                        <TableColumn fx:id="colSrednjiKurs" text="Srednji kurs" prefWidth="120"/>
                        <TableColumn fx:id="colIznosRsd" text="Iznos (RSD)" prefWidth="120"/>
                    </columns>
                    <placeholder>
                        <Label text="Nema evidencije o uplatama" style="-fx-text-fill: gray;"/>
                    </placeholder>
                </TableView>

                <!-- Ukupno uplaćeno -->
                <HBox spacing="20" alignment="CENTER_RIGHT" styleClass="result-box">
                    <Label text="Ukupno uplaćeno:" styleClass="label-bold">
                        <font>
                            <Font size="14"/>
                        </font>
                    </Label>
                    <Label fx:id="lblUkupnoUplaceno" text="0.00 EUR" styleClass="result-value">
                        <font>
                            <Font name="System Bold" size="18"/>
                        </font>
                    </Label>
                </HBox>
            </VBox>
        </Tab>

    </TabPane>

</VBox>
<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports
              http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="zapisnik_sa_ispita" pageWidth="595" pageHeight="842"
              columnWidth="535" leftMargin="30" rightMargin="30"
              topMargin="20" bottomMargin="20">

    <parameter name="predmet" class="java.lang.String"/>
    <parameter name="sifraPredmeta" class="java.lang.String"/>
    <parameter name="ispitniRok" class="java.lang.String"/>
    <parameter name="datumOdrzavanja" class="java.time.LocalDate"/>
    <parameter name="nastavnik" class="java.lang.String"/>
    <parameter name="datumIzdavanja" class="java.time.LocalDate"/>

    <field name="studijskiProgram" class="java.lang.String"/>
    <field name="godinaUpisa" class="java.lang.Integer"/>
    <field name="brojIndeksa" class="java.lang.Integer"/>
    <field name="imeStudenta" class="java.lang.String"/>
    <field name="prezimeStudenta" class="java.lang.String"/>
    <field name="poeniPredispitne" class="java.lang.Integer"/>
    <field name="poeniIspit" class="java.lang.Integer"/>
    <field name="ukupnoPoeni" class="java.lang.Integer"/>
    <field name="ocena" class="java.lang.Integer"/>
    <field name="polozio" class="java.lang.Boolean"/>

    <variable name="brojPolozenih" class="java.lang.Integer" calculation="Sum">
        <variableExpression><![CDATA[$F{polozio} ? 1 : 0]]></variableExpression>
    </variable>

    <variable name="prosecnaOcena" class="java.lang.Double" calculation="Average">
        <variableExpression><![CDATA[$F{polozio} ? $F{ocena}.doubleValue() : null]]></variableExpression>
    </variable>

    <title>
        <band height="200">
            <staticText>
                <reportElement x="0" y="10" width="535" height="30"/>
                <textElement textAlignment="Center">
                    <font size="18" isBold="true"/>
                </textElement>
                <text><![CDATA[Računarski fakultet - Univerzitet Union]]></text>
            </staticText>

            <line>
                <reportElement x="0" y="50" width="535" height="1"/>
            </line>

            <staticText>
                <reportElement x="0" y="70" width="535" height="30"/>
                <textElement textAlignment="Center">
                    <font size="16" isBold="true"/>
                </textElement>
                <text><![CDATA[ZAPISNIK SA ISPITA]]></text>
            </staticText>

            <!-- Predmet info -->
            <staticText>
                <reportElement x="0" y="120" width="100" height="20"/>
                <textElement><font size="11" isBold="true"/></textElement>
                <text><![CDATA[Predmet:]]></text>
            </staticText>

            <textField>
                <reportElement x="100" y="120" width="435" height="20"/>
                <textElement><font size="11"/></textElement>
                <textFieldExpression><![CDATA[$P{sifraPredmeta} + " - " + $P{predmet}]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement x="0" y="145" width="100" height="20"/>
                <textElement><font size="11" isBold="true"/></textElement>
                <text><![CDATA[Ispitni rok:]]></text>
            </staticText>

            <textField>
                <reportElement x="100" y="145" width="200" height="20"/>
                <textElement><font size="11"/></textElement>
                <textFieldExpression><![CDATA[$P{ispitniRok}]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement x="320" y="145" width="100" height="20"/>
                <textElement><font size="11" isBold="true"/></textElement>
                <text><![CDATA[Datum:]]></text>
            </staticText>

            <textField>
                <reportElement x="420" y="145" width="115" height="20"/>
                <textElement><font size="11"/></textElement>
                <textFieldExpression><![CDATA[$P{datumOdrzavanja}.toString()]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement x="0" y="170" width="100" height="20"/>
                <textElement><font size="11" isBold="true"/></textElement>
                <text><![CDATA[Nastavnik:]]></text>
            </staticText>

            <textField>
                <reportElement x="100" y="170" width="435" height="20"/>
                <textElement><font size="11"/></textElement>
                <textFieldExpression><![CDATA[$P{nastavnik}]]></textFieldExpression>
            </textField>
        </band>
    </title>

    <columnHeader>
        <band height="30">
            <staticText>
                <reportElement x="0" y="5" width="30" height="20"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center">
                    <font size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[Rb.]]></text>
            </staticText>

            <staticText>
                <reportElement x="30" y="5" width="80" height="20"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center">
                    <font size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[Indeks]]></text>
            </staticText>

            <staticText>
                <reportElement x="110" y="5" width="170" height="20"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center">
                    <font size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[Ime i prezime]]></text>
            </staticText>

            <staticText>
                <reportElement x="280" y="5" width="60" height="20"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center">
                    <font size="8" isBold="true"/>
                </textElement>
                <text><![CDATA[Predisp.]]></text>
            </staticText>

            <staticText>
                <reportElement x="340" y="5" width="60" height="20"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center">
                    <font size="8" isBold="true"/>
                </textElement>
                <text><![CDATA[Ispit]]></text>
            </staticText>

            <staticText>
                <reportElement x="400" y="5" width="60" height="20"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center">
                    <font size="8" isBold="true"/>
                </textElement>
                <text><![CDATA[Ukupno]]></text>
            </staticText>

            <staticText>
                <reportElement x="460" y="5" width="75" height="20"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center">
                    <font size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[Ocena]]></text>
            </staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="20">
            <textField>
                <reportElement x="0" y="0" width="30" height="20"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center">
                    <font size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[$V{REPORT_COUNT}]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="30" y="0" width="80" height="20"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center">
                    <font size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{studijskiProgram} + " " + $F{godinaUpisa} + "/" + $F{brojIndeksa}]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="110" y="0" width="170" height="20"/>
                <box leftPadding="5"><pen lineWidth="0.5"/></box>
                <textElement>
                    <font size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{imeStudenta} + " " + $F{prezimeStudenta}]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="280" y="0" width="60" height="20"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center">
                    <font size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{poeniPredispitne}]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="340" y="0" width="60" height="20"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center">
                    <font size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{poeniIspit}]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="400" y="0" width="60" height="20"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center">
                    <font size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{ukupnoPoeni}]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="460" y="0" width="75" height="20"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Center">
                    <font size="9" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{polozio} ? $F{ocena} : "-"]]></textFieldExpression>
            </textField>
        </band>
    </detail>

    <summary>
        <band height="120">
            <line>
                <reportElement x="0" y="10" width="535" height="1"/>
            </line>

            <staticText>
                <reportElement x="280" y="20" width="120" height="20"/>
                <textElement textAlignment="Right">
                    <font size="11" isBold="true"/>
                </textElement>
                <text><![CDATA[Broj položenih:]]></text>
            </staticText>

            <textField>
                <reportElement x="400" y="20" width="60" height="20"/>
                <textElement textAlignment="Center">
                    <font size="11" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$V{brojPolozenih}]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement x="280" y="45" width="120" height="20"/>
                <textElement textAlignment="Right">
                    <font size="11" isBold="true"/>
                </textElement>
                <text><![CDATA[Prosečna ocena:]]></text>
            </staticText>

            <textField pattern="#0.00">
                <reportElement x="400" y="45" width="60" height="20"/>
                <textElement textAlignment="Center">
                    <font size="11" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$V{prosecnaOcena} != null ? $V{prosecnaOcena} : "-"]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement x="50" y="90" width="100" height="20"/>
                <textElement><font size="10"/></textElement>
                <text><![CDATA[Sačinio:]]></text>
            </staticText>

            <textField>
                <reportElement x="150" y="90" width="200" height="20"/>
                <textElement><font size="10"/></textElement>
                <textFieldExpression><![CDATA[$P{nastavnik}]]></textFieldExpression>
            </textField>

            <line>
                <reportElement x="350" y="85" width="150" height="1"/>
            </line>

            <staticText>
                <reportElement x="350" y="90" width="150" height="20"/>
                <textElement textAlignment="Center">
                    <font size="10"/>
                </textElement>
                <text><![CDATA[Potpis]]></text>
            </staticText>
        </band>
    </summary>

    <pageFooter>
        <band height="40">
            <staticText>
                <reportElement x="0" y="10" width="535" height="15"/>
                <textElement textAlignment="Center">
                    <font size="9" isItalic="true"/>
                </textElement>
                <text><![CDATA[Računarski fakultet | Kneza Višeslava 1a, Beograd | www.raf.edu.rs]]></text>
            </staticText>

            <textField>
                <reportElement x="450" y="25" width="85" height="15"/>
                <textElement textAlignment="Right">
                    <font size="8"/>
                </textElement>
                <textFieldExpression><![CDATA["Stranica " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>

</jasperReport>